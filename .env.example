# Copy to .env and fill in secrets. Never commit .env.

# 运行环境：1=线上(Docker), 2=本地开发
RUN_MODE=2

# 业务数据库：PostgreSQL
DATABASE_URL=postgresql://trandsai:change-me@postgres:5432/trandsai
MODEL_PROVIDER=deepseek
ADMIN_PASSWORD=change-me
# 逗号分隔；不填则仅允许本机前端
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# 服务端口配置
PORT=8000

# 存储后端切换：1=GCS (Google Cloud Storage), 2=COS (腾讯云)
STORAGE_BACKEND=2

# 腾讯云 COS 配置（STORAGE_BACKEND=2 时使用）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=

# Google Cloud Storage 配置（STORAGE_BACKEND=1 时使用）
GCS_BUCKET=

# 线上路径（Docker 内）
GCS_CREDENTIALS_PROD=/app/certs/google-service-account.json
# 本地路径（从 server/ 目录启动）
GCS_CREDENTIALS_LOCAL=certs/google-service-account.json

# 阿里云百炼 DashScope 文生图配置
DASHSCOPE_API_KEY=
API_URL=
MODEL_NAME=

#调用文字大模型配置
DEEPSEEK_API_KEY=

XAI_API_KEY=

# Gemini 文生文 + 文生图（同一 API Key；出图模型见 GEMINI_IMAGE_MODEL）
GOOGLEAI_API_KEY=
GOOGLE_API_KEY=

GEMINI_TEXT_MODEL=
GEMINI_IMAGE_MODEL=
GEMINI_API_BASE=

# Redis（用户指定，无密码）
# 聊天短期记忆：热读 Redis，空则回填 PG；写路径 Redis + 后台 flush 落 PG
CHAT_REDIS_BRIDGE=1

# Respond 注入近聊条数（默认 30；不足则全量）
MEMORY_RECENT_MESSAGES=30

# 会撩/绿茶风格（提示词内建；1=强调）
FLIRT_TEA=1

# 回复多样性（偏低：过高会破坏表达逻辑，出现怪词/跳句）
LLM_FREQUENCY_PENALTY=0.12
LLM_PRESENCE_PENALTY=
# scrub=只清违禁词，不做语气尾巴/叠词扰动
HUMANIZE=scrub

AGENT_PIPELINE=
MOTIVE_EXTREME=

# ========== Docker 服务配置 ==========
# PostgreSQL
POSTGRES_USER=trandsai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trandsai

# Redis（compose 内服务名 redis；本地开发可改 127.0.0.1）
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
MAX_CONNECTIONS=100
#Google登陆
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

#apple登陆
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_SERVICE_ID=
APPLE_PRIVATE_KEY_PATH=certs/AuthKey_XXXXXXXX.p8
# 马甲包 Bundle ID：请求头 X-App-Key=kaya 时用作 Apple aud / client_id（可逗号多个）
APPLE_CLIENT_IDS=

# App Store Connect API (用于获取各地区价格)
APP_STORE_KEY_ID=
APP_STORE_ISSUER_ID=
APP_STORE_PRIVATE_KEY_PATH=certs/AuthKey_XXXXXXXX.p8

# Apple IAP 共享密钥（用于验证收据）
APPLE_IAP_SHARED_SECRET=

# Google Play 配置
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=certs/google-play.json
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_RTDN_SKIP_AUTH=
MAX_TOKENS_FREE=256
MAX_TOKENS_PAID=512
MAX_TOKENS_AFF_LOW=
MAX_TOKENS_AFF_MID=
GOOGLE_RTDN_SERVICE_ACCOUNT=

# 消息策略：正式服关闭 test_ 前缀（前端与策略均用裸 event_key）
# true/1/yes/on=开启；false/0/no/空=关闭
# PRODUCT_EVENT_TEST_PREFIX=false
PRODUCT_EVENT_TEST_PREFIX=false
AUTO_MOMENTS_ENABLED=true
GA4_API_SECRET=
GA4_MEASUREMENT_ID=
AFFECTION_DEFAULT=0
# Cloud Translation API（IM 翻译优先；失败回退百度）
# 文档：https://docs.cloud.google.com/translate/docs
GOOGLE_TRANSLATE_API_KEY=

