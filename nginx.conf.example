# liaosao.xyz / .live / .life：HTTP→HTTPS，各域名独立证书。
# 证书目录 page/cert/ → /etc/nginx/certs/

upstream backend_pool {
    ip_hash;
    server trandsai-backend:8000;
}

# HTTP：域名跳转 HTTPS
server {
    listen 80;
    server_name liaosao.xyz www.liaosao.xyz liaosao.live www.liaosao.live liaosao.life www.liaosao.life;

    location /.well-known/acme-challenge/ {
        root /usr/share/nginx/html/file;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTP：IP / localhost 调试
server {
    listen 80;
    server_name 139.162.72.71 localhost;

    client_max_body_size 40m;
    include /etc/nginx/conf.d/app_locations.inc;
}

# HTTPS: liaosao.xyz
server {
    listen 443 ssl http2;
    server_name liaosao.xyz www.liaosao.xyz;

    ssl_certificate     /etc/nginx/certs/jnaliaosao_xyz.crt;
    ssl_certificate_key /etc/nginx/certs/jnaliaosao_xyz.key;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 40m;
    include /etc/nginx/conf.d/app_locations.inc;
}

# HTTPS: liaosao.live
server {
    listen 443 ssl http2;
    server_name liaosao.live www.liaosao.live;

    ssl_certificate     /etc/nginx/certs/jnaliaosao_live.crt;
    ssl_certificate_key /etc/nginx/certs/jnaliaosao_live.key;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 40m;
    include /etc/nginx/conf.d/app_locations.inc;
}

# HTTPS: liaosao.life
server {
    listen 443 ssl http2;
    server_name liaosao.life www.liaosao.life;

    ssl_certificate     /etc/nginx/certs/jnaliaosao_life.crt;
    ssl_certificate_key /etc/nginx/certs/jnaliaosao_life.key;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 40m;
    include /etc/nginx/conf.d/app_locations.inc;
}
